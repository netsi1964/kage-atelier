{
  "name": "kageatelier",
  "version": "1.0.0",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env main.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env main.ts",
    "check": "deno check lib/mod.ts main.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-net --no-lock lib/engine_test.ts lib/recipe_store_test.ts",
    "deploy": "deployctl deploy --project=kage-atelier --entrypoint=main.ts --prod --include=main.ts --include=lib --include=public --include=deno.json --save-config",
    "dialog": "deno run --allow-net --allow-read --allow-env tools/dialog-view.ts",
    "migrate-kv": "deno run --allow-read --allow-write --allow-env --allow-net tools/migrate-kv.ts"
  },
  "deploy": {
    "project": "kage-atelier",
    "entrypoint": "main.ts",
    "include": [
      "main.ts",
      "lib",
      "public",
      "deno.json"
    ],
    "exclude": [
      "legacy-monolith.html",
      "**/*_test.ts",
      "data",
      "tools",
      "docs"
    ]
  },
  "exports": {
    ".": "./lib/mod.ts"
  },
  "lock": false,
  "compilerOptions": {
    "strict": true
  },
  "unstable": [
    "kv"
  ]
}
